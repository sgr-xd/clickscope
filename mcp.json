{
  "mcpServers": {
    "clickscope": {
      "command": "uvx",
      "args": ["--from", "${CLAUDE_PLUGIN_ROOT}", "clickscope"],
      "env": {
        "CLICKHOUSE_HOST": "${user_config.CLICKHOUSE_HOST}",
        "CLICKHOUSE_PORT": "${user_config.CLICKHOUSE_PORT}",
        "CLICKHOUSE_USER": "${user_config.CLICKHOUSE_USER}",
        "CLICKHOUSE_PASSWORD": "${user_config.CLICKHOUSE_PASSWORD}",
        "CLICKHOUSE_DATABASE": "${user_config.CLICKHOUSE_DATABASE}",
        "CLICKHOUSE_SECURE": "${user_config.CLICKHOUSE_SECURE}",
        "CLICKSCOPE_PROFILES": "${user_config.CLICKSCOPE_PROFILES}",
        "CLICKSCOPE_AUDIT_LOG": "${user_config.CLICKSCOPE_AUDIT_LOG}"
      }
    }
  }
}
